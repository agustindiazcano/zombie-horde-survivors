{
  "name": "zombie-horde-survivors",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:sim": "node scripts/bench-sim.mjs",
    "bench:physics": "node scripts/bench-physics.mjs",
    "check:ragdoll": "node scripts/check-ragdoll.mjs",
    "check:rapier": "node scripts/check-rapier.mjs",
    "check:sim-hash": "node scripts/check-sim-hash.mjs",
    "check:kernels": "node scripts/check-kernels.mjs",
    "check:dmath": "node scripts/check-dmath.mjs",
    "check:ocean": "node scripts/check-ocean.mjs",
    "check:ocean-wasm": "node scripts/check-ocean-wasm.mjs",
    "build:wasm": "wasm-pack build crates/sim-core --release --target web --no-pack --out-dir ../../src/wasm/sim-core",
    "check:assets": "node scripts/check-assets.mjs",
    "credits": "node scripts/generate-credits.mjs && prettier --write README.md"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
